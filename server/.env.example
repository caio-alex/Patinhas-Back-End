# Copie este arquivo para .env e ajuste os valores.
# NUNCA commite o .env de verdade.

# String de conexão do Postgres. Quando rodando via docker-compose,
# o host "db" é o nome do serviço definido no docker-compose.yml.
DATABASE_URL="postgresql://patinhas:patinhas@db:5432/patinhas_store?schema=public"

# Porta em que a API vai escutar
PORT=3333

# Segredos do JWT - gere valores aleatórios longos, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="troque-este-valor-por-um-segredo-aleatorio-de-verdade"
JWT_REFRESH_SECRET="troque-este-valor-por-outro-segredo-aleatorio-diferente"

# Tempo de vida dos tokens
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Origem permitida para CORS (o front em desenvolvimento)
CORS_ORIGIN="http://localhost:3000"
